# ============ PCC Identity Service - environment variables ============

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/pcc_identity_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Server
SERVER_PORT=8081

# JWT - REQUIRED in every environment (min 64 chars, HS512 key material)
JWT_SECRET=change-me-to-a-64-plus-character-random-secret
JWT_ISSUER=pcc-identity-service
JWT_AUDIENCE=pcc-property-management
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Account lockout
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCK_DURATION_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# CORS (comma separated, React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Refresh cookie - set true behind HTTPS in production
COOKIE_SECURE=false

# First-boot admin account (used only when no ADMIN user exists)
PCC_ADMIN_USERNAME=admin
PCC_ADMIN_EMAIL=admin@pcc-cameroon.local
PCC_ADMIN_PASSWORD=          # empty => generated once, printed to startup log
PCC_ADMIN_EMPLOYEE_CODE=PCC-0001
PCC_ADMIN_FIRST_NAME=System
PCC_ADMIN_LAST_NAME=Administrator
