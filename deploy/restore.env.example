# Copy to /etc/pcc/restore.env (root:pcc, 0640); never commit populated secrets.
AGE_IDENTITY_FILE=/etc/pcc/backup.agekey
RESTORE_ROOT=/var/lib/pcc/restore-test
RESTORE_DOC_ROOT=/var/lib/pcc/restore-test/documents
RESTORE_DB_IDENTITY_USER=pcc_restore_identity
RESTORE_DB_IDENTITY_PASSWORD=CHANGE_ME
RESTORE_DB_PROPERTY_USER=pcc_restore_property
RESTORE_DB_PROPERTY_PASSWORD=CHANGE_ME
RESTORE_DB_LAND_USER=pcc_restore_land
RESTORE_DB_LAND_PASSWORD=CHANGE_ME
RESTORE_DB_FINANCE_USER=pcc_restore_finance
RESTORE_DB_FINANCE_PASSWORD=CHANGE_ME
RESTORE_DB_DOCUMENT_USER=pcc_restore_document
RESTORE_DB_DOCUMENT_PASSWORD=CHANGE_ME
RESTORE_DB_WORKFLOW_USER=pcc_restore_workflow
RESTORE_DB_WORKFLOW_PASSWORD=CHANGE_ME
RESTORE_DB_REPORTING_USER=pcc_restore_reporting
RESTORE_DB_REPORTING_PASSWORD=CHANGE_ME
