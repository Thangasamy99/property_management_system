[Unit]
Description=Encrypted PCC database and document backup
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pcc/pcc.env
EnvironmentFile=/etc/pcc/backup.env
ExecStart=/opt/pcc/deploy/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/pcc
