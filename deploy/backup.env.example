# Copy to /etc/pcc/backup.env (root:pcc, 0640); do not commit the populated file.
AGE_RECIPIENT=age1_REPLACE_WITH_APPROVED_OFFSITE_RECIPIENT
BACKUP_DIR=/var/backups/pcc
BACKUP_DB_IDENTITY_USER=pcc_backup_identity
BACKUP_DB_IDENTITY_PASSWORD=CHANGE_ME
BACKUP_DB_PROPERTY_USER=pcc_backup_property
BACKUP_DB_PROPERTY_PASSWORD=CHANGE_ME
BACKUP_DB_LAND_USER=pcc_backup_land
BACKUP_DB_LAND_PASSWORD=CHANGE_ME
BACKUP_DB_FINANCE_USER=pcc_backup_finance
BACKUP_DB_FINANCE_PASSWORD=CHANGE_ME
BACKUP_DB_DOCUMENT_USER=pcc_backup_document
BACKUP_DB_DOCUMENT_PASSWORD=CHANGE_ME
BACKUP_DB_WORKFLOW_USER=pcc_backup_workflow
BACKUP_DB_WORKFLOW_PASSWORD=CHANGE_ME
BACKUP_DB_REPORTING_USER=pcc_backup_reporting
BACKUP_DB_REPORTING_PASSWORD=CHANGE_ME
