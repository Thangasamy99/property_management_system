# PCC production environment template — copy to /etc/pcc/pcc.env, chmod 600.
# NEVER commit the real file. Rotate every secret before first deploy.

# Shared JWT signing secret (>=64 chars, used by ALL services + gateway).
JWT_SECRET=CHANGE_ME_generate_64_plus_random_chars
JWT_ISSUER=pcc-identity-service
JWT_AUDIENCE=pcc-property-management
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
COOKIE_SECURE=true

# Each service gets its own /etc/pcc/<instance>.env with a unique DB account.
# Example DB_URL per instance:
# jdbc:mysql://127.0.0.1:3306/pcc_identity_db?useSSL=true&serverTimezone=UTC
# Set DB_USERNAME and DB_PASSWORD in that same protected instance file.
# Do not use one shared DB account across services.

# Gateway → service upstreams (same host; adjust if split).
IDENTITY_SERVICE_URL=http://127.0.0.1:8081
PROPERTY_SERVICE_URL=http://127.0.0.1:8082
LAND_SERVICE_URL=http://127.0.0.1:8083
FINANCE_SERVICE_URL=http://127.0.0.1:8084
DOCUMENT_SERVICE_URL=http://127.0.0.1:8085
WORKFLOW_SERVICE_URL=http://127.0.0.1:8086
REPORTING_SERVICE_URL=http://127.0.0.1:8087

# Reporting → service calls (same upstreams).
IDENTITY_URL=http://127.0.0.1:8081
PROPERTY_URL=http://127.0.0.1:8082
LAND_URL=http://127.0.0.1:8083
FINANCE_URL=http://127.0.0.1:8084
DOCUMENT_URL=http://127.0.0.1:8085
WORKFLOW_URL=http://127.0.0.1:8086

# CORS — frontend origin served by Nginx.
CORS_ALLOWED_ORIGINS=https://pcc.example.com

# Identity cookie + initial admin bootstrap (identity instance file only):
# COOKIE_SECURE=true
# PCC_ADMIN_PASSWORD=<set once via secure secret manager; do not log>

# Document storage — private dir, outside any web root.
DOC_STORAGE_ROOT=/var/lib/pcc/documents
DOC_MAX_FILE_SIZE=26214400

# Frontend build-time (see deploy/DEPLOYMENT.md):
# VITE_GATEWAY_URL=https://pcc.example.com/api
